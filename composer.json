{
    "name": "gaurav/laravel-incidentlens",
    "description": "High-performance, Rust-powered diagnostic engine, security auditor, and interactive TUI for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "diagnostics",
        "rust",
        "n-plus-one",
        "security",
        "performance",
        "tui",
        "audit"
    ],
    "homepage": "https://github.com/Gauravgpil/laravel-incidentlens",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gaurav\\IncidentLens\\": "packages/laravel/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gaurav\\IncidentLens\\Tests\\": "packages/laravel/tests/"
        }
    },
    "bin": [
        "packages/laravel/bin/incidentlens"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Gaurav\\IncidentLens\\IncidentLensServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit -c packages/laravel/phpunit.xml"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
