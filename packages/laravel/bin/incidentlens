#!/usr/bin/env php
<?php

declare(strict_types=1);

$projectRoot = getcwd() ?: dirname(__DIR__, 4);
$binName = DIRECTORY_SEPARATOR === '\\' ? 'incidentlens.exe' : 'incidentlens';
$selfReal = realpath(__FILE__) ?: __FILE__;

$isNativeBinary = static function (string $path) use ($selfReal): bool {
    $real = realpath($path);
    if ($real === false || $real === $selfReal || ! is_file($real)) {
        return false;
    }
    if (DIRECTORY_SEPARATOR !== '\\' && ! is_executable($real)) {
        return false;
    }
    $head = @file_get_contents($real, false, null, 0, 64);
    if (is_string($head) && (str_contains($head, '<?php') || str_contains($head, 'env php'))) {
        return false;
    }
    return true;
};

$candidates = array_filter([
    getenv('INCIDENTLENS_BINARY') ?: null,
    $projectRoot . DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR . 'bin' . DIRECTORY_SEPARATOR . 'incidentlens-engine' . (DIRECTORY_SEPARATOR === '\\' ? '.exe' : ''),
    $projectRoot . DIRECTORY_SEPARATOR . 'target' . DIRECTORY_SEPARATOR . 'release' . DIRECTORY_SEPARATOR . $binName,
    $projectRoot . DIRECTORY_SEPARATOR . 'target' . DIRECTORY_SEPARATOR . 'debug' . DIRECTORY_SEPARATOR . $binName,
    __DIR__ . DIRECTORY_SEPARATOR . 'incidentlens-engine' . (DIRECTORY_SEPARATOR === '\\' ? '.exe' : ''),
]);

$binary = null;
foreach ($candidates as $candidate) {
    if ($isNativeBinary($candidate)) {
        $binary = $candidate;
        break;
    }
}

if ($binary === null) {
    $pathEnv = getenv('PATH') ?: '';
    foreach (explode(PATH_SEPARATOR, $pathEnv) as $dir) {
        $p = rtrim($dir, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR . $binName;
        if ($isNativeBinary($p)) {
            $binary = $p;
            break;
        }
    }
}

if ($binary === null) {
    fwrite(STDERR, "error: IncidentLens native Rust binary not found. Set INCIDENTLENS_BINARY or place the compiled Rust binary in /usr/local/bin/incidentlens.\n");
    exit(3);
}

$args = array_slice($argv, 1);
$cmd = array_merge([$binary], $args);

$descriptors = [
    0 => STDIN,
    1 => STDOUT,
    2 => STDERR,
];

$process = proc_open($cmd, $descriptors, $pipes);
if (! is_resource($process)) {
    fwrite(STDERR, "error: failed to launch IncidentLens Rust engine.\n");
    exit(3);
}

$exitCode = proc_close($process);
exit((int) $exitCode);
