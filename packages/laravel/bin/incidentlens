#!/usr/bin/env php
<?php

declare(strict_types=1);

$projectRoot = getcwd() ?: dirname(__DIR__, 4);
$binName = DIRECTORY_SEPARATOR === '\\' ? 'incidentlens.exe' : 'incidentlens';

$candidates = array_filter([
    getenv('INCIDENTLENS_BINARY') ?: null,
    $projectRoot . DIRECTORY_SEPARATOR . 'target' . DIRECTORY_SEPARATOR . 'release' . DIRECTORY_SEPARATOR . $binName,
    $projectRoot . DIRECTORY_SEPARATOR . 'target' . DIRECTORY_SEPARATOR . 'debug' . DIRECTORY_SEPARATOR . $binName,
    __DIR__ . DIRECTORY_SEPARATOR . $binName,
]);

$binary = null;
foreach ($candidates as $candidate) {
    if (is_file($candidate) && (DIRECTORY_SEPARATOR === '\\' || is_executable($candidate))) {
        $binary = $candidate;
        break;
    }
}

if ($binary === null) {
    $pathEnv = getenv('PATH') ?: '';
    foreach (explode(PATH_SEPARATOR, $pathEnv) as $dir) {
        $p = rtrim($dir, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR . $binName;
        if (is_file($p) && (DIRECTORY_SEPARATOR === '\\' || is_executable($p))) {
            $binary = $p;
            break;
        }
    }
}

if ($binary === null) {
    fwrite(STDERR, "error: IncidentLens Rust binary not found. Run `php artisan incidentlens:install` or set INCIDENTLENS_BINARY.\n");
    exit(3);
}

$args = array_slice($argv, 1);
$escaped = array_map('escapeshellarg', $args);
$cmd = escapeshellarg($binary) . ($escaped !== [] ? ' ' . implode(' ', $escaped) : '');

passthru($cmd, $exitCode);
exit((int) $exitCode);
