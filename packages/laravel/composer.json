{
    "name": "incidentlens/laravel",
    "description": "High-performance, Rust-powered diagnostic engine and CLI for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "symfony/process": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gaurav\\IncidentLens\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gaurav\\IncidentLens\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/incidentlens"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Gaurav\\IncidentLens\\IncidentLensServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
